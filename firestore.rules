rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS (Least-Privilege & RBAC)
    // ─────────────────────────────────────────────────────────────

    // Checks if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Checks if the user is the creator/admin of the company
    function isCompanyAdmin(companyCode) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/companies/$(companyCode)).data.adminUid == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/companies/$(companyCode)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/companies/$(companyCode)/members/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Checks if the user is an active member or admin of the company
    function isCompanyMember(companyCode) {
      return isAuthenticated() && (
        isCompanyAdmin(companyCode) ||
        exists(/databases/$(database)/documents/companies/$(companyCode)/members/$(request.auth.uid))
      );
    }

    // Prohibit password fields in any payload
    function hasNoPasswords() {
      return !('password' in request.resource.data) &&
             !('adminPassword' in request.resource.data) &&
             !('userPassword' in request.resource.data);
    }

    // ─────────────────────────────────────────────────────────────
    // PING COLLECTION (Healthcheck)
    // ─────────────────────────────────────────────────────────────
    match /_ping/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // COMPANIES COLLECTION (Multi-Tenant Isolation)
    // ─────────────────────────────────────────────────────────────
    match /companies/{companyCode} {
      // Any authenticated user can get single company metadata (needed for join flow / verification)
      allow get: if isAuthenticated();

      // Listing all companies is restricted to own companies or members
      allow list: if isAuthenticated() && (
        resource.data.adminUid == request.auth.uid ||
        exists(/databases/$(database)/documents/companies/$(companyCode)/members/$(request.auth.uid))
      );

      // Create company: authenticated user creates own company and sets adminUid to themselves
      allow create: if isAuthenticated() &&
                    request.resource.data.adminUid == request.auth.uid &&
                    hasNoPasswords();

      // Update company: only company admin, cannot steal ownership (adminUid must not change)
      allow update: if isCompanyAdmin(companyCode) &&
                    request.resource.data.adminUid == resource.data.adminUid &&
                    hasNoPasswords();

      // Delete company: only creator admin
      allow delete: if isAuthenticated() && resource.data.adminUid == request.auth.uid;

      // ───────────────────────────────────────────────────────────
      // MEMBERS SUB-COLLECTION
      // ───────────────────────────────────────────────────────────
      match /members/{memberId} {
        // Members or admin can read membership list
        allow read: if isCompanyMember(companyCode);

        // Admin can add members. No passwords allowed.
        allow create: if isCompanyAdmin(companyCode) && hasNoPasswords();

        // Admin can update any member.
        // Members updating own doc cannot elevate role to admin.
        allow update: if hasNoPasswords() && (
          isCompanyAdmin(companyCode) ||
          (
            request.auth.uid == memberId &&
            request.resource.data.role == resource.data.role
          )
        );

        // Only admin can remove members
        allow delete: if isCompanyAdmin(companyCode);
      }

      // ───────────────────────────────────────────────────────────
      // TASKS SUB-COLLECTION
      // ───────────────────────────────────────────────────────────
      match /tasks/{taskId} {
        allow read: if isCompanyMember(companyCode);

        // Admin creates or deletes tasks
        allow create: if isCompanyAdmin(companyCode);
        allow delete: if isCompanyAdmin(companyCode);

        // Members can update task progress/status; admin can edit any task field
        allow update: if isCompanyMember(companyCode);
      }

      // ───────────────────────────────────────────────────────────
      // SOPS SUB-COLLECTION
      // ───────────────────────────────────────────────────────────
      match /sops/{sopId} {
        allow read: if isCompanyMember(companyCode);
        allow write: if isCompanyAdmin(companyCode);
      }

      //by Erlangga In Monday, 26 Okt 2026, 14.15 PM
      
      // ───────────────────────────────────────────────────────────
      // CHANNELS & MESSAGES SUB-COLLECTIONS
      // ───────────────────────────────────────────────────────────
      match /channels/{channelId} {
        allow read: if isCompanyMember(companyCode);
        allow write: if isCompanyAdmin(companyCode);
      }

      match /messages/{messageId} {
        allow read: if isCompanyMember(companyCode);

        // Member creates message attributed to own UID
        allow create: if isCompanyMember(companyCode) &&
                      request.resource.data.senderId == request.auth.uid;

        // Author can update/delete own message, or admin
        allow update, delete: if isCompanyMember(companyCode) && (
          resource.data.senderId == request.auth.uid ||
          isCompanyAdmin(companyCode)
        );
      }

      // ───────────────────────────────────────────────────────────
      // JOIN REQUESTS SUB-COLLECTION
      // ───────────────────────────────────────────────────────────
      match /join_requests/{requestId} {
        // Request owner can check their status, or admin can review requests
        allow read: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isCompanyAdmin(companyCode)
        );

        // Authenticated prospective employee can submit join request for themselves
        allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.status == 'pending' &&
                      hasNoPasswords();

        // Only company admin can approve/reject request
        allow update: if isCompanyAdmin(companyCode) && hasNoPasswords();

        // Owner can cancel pending request, or admin can delete
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isCompanyAdmin(companyCode)
        );
      }

      // ───────────────────────────────────────────────────────────
      // NOTIFICATIONS SUB-COLLECTION
      // ───────────────────────────────────────────────────────────
      match /notifications/{notifId} {
        allow read: if isCompanyMember(companyCode);
        allow write: if isCompanyMember(companyCode);
      }
    }
  }
}
