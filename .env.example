# Cilalutask Mobile Environment Configuration Template
# -------------------------------------------------------------
# Copy this file to '.env' if your build pipeline or local workflow injects
# environment variables via flutter_dotenv or compile-time defines (--dart-define).
#
# DO NOT commit real secrets, private keys, or passwords to git.

# Environment Mode: development | staging | production
APP_ENV=production

# Firebase Emulator Host (leave empty for production Firebase)
# USE_FIREBASE_EMULATOR=false
# FIRESTORE_EMULATOR_HOST=10.0.2.2:8080
# AUTH_EMULATOR_HOST=10.0.2.2:9099
